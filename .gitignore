# ==============================================================================
# CampusHub Root .gitignore
# ==============================================================================

# 1. Dependencies
node_modules/
*/node_modules/
jspm_packages/
.pnpm-store/

# 2. Environment Variables & Secret Keys (Crucial for Deployment Security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# 3. Production & Build Outputs
dist/
dist-ssr/
build/
out/
*/dist/
*/build/
.next/

# 4. User Uploads & Media (Preserve directory structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# 5. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Testing & Coverage
coverage/
.nyc_output/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# 7. Python Artifacts (From project report & screenshot scripts)
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.venv/
venv/
ENV/

# 8. Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 9. Operating System & Temporary Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
~$*
*.tmp
