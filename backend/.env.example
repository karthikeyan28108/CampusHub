# Encryption at Rest (AES-256-GCM 32-byte Base64 Encoded Key)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET_KEY=base64_encoded_32_byte_key_here
